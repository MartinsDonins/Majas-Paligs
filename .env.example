# Mājas Palīgs — environment template. Copy to .env (dev) — NEVER commit real secrets.
# Production values live only in Coolify (MVP-SPEC A.2 "Coolify env").
APP_NAME="Mājas Palīgs"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Europe/Riga

APP_LOCALE=lv
APP_FALLBACK_LOCALE=lv
APP_FAKER_LOCALE=lv_LV

APP_MAINTENANCE_DRIVER=file

# Dedicated keys (PLANNING §5 A04) — generate each with: php artisan majas:keys
# base64:<32 random bytes>. Never reuse APP_KEY. Escrow offline (docs/SECURITY.md).
PLATE_ENC_KEY=
PLATE_INDEX_KEY=
INVITE_KEY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# App connection = majas_app (DML only). Owner creds are used ONLY by the migrate service.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=majas
DB_USERNAME=majas_app
DB_PASSWORD=app-dev-only
DB_OWNER_USERNAME=majas_owner
DB_OWNER_PASSWORD=owner-dev-only
DB_RETENTION_USERNAME=majas_retention
DB_RETENTION_PASSWORD=retention-dev-only
# Dev-only superuser password of the local postgres container
PG_SUPERUSER_PASSWORD=postgres-dev-only

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave SESSION_DOMAIN unset (host-only cookie, required by the __Host- prefix). Secure stays true even
# locally: browsers treat http://localhost as a secure context.
SESSION_COOKIE=__Host-mp_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=mp

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@kaimini.coredigify.com"
MAIL_FROM_NAME="${APP_NAME}"

# GlitchTip (EU, self-hosted) — leave empty locally
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Platform admin alerts (count-only payloads)
PLATFORM_ALERT_EMAIL=

# Local docker ports / host user (scripts/dev.sh fills USER_ID/GROUP_ID)
APP_PORT=8080
MAILPIT_UI_PORT=8025
PG_PORT=54329
VITE_PORT=5173
VITE_POLLING=1
XDEBUG_MODE=off
USER_ID=1000
GROUP_ID=1000

VITE_APP_NAME="${APP_NAME}"
