{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "coredigify/majas-paligs",
    "type": "project",
    "description": "Mājas Palīgs — house operating layer for residents of Latvian apartment buildings.",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^5.10.2",
        "intervention/image": "^4.4",
        "laravel/framework": "^13.37",
        "laravel/horizon": "^5.50",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.4.7",
        "mallardduck/blade-lucide-icons": "^2.0",
        "sentry/sentry-laravel": "^4.29",
        "spatie/laravel-translatable": "^6.14"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Support\\": "database/support/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --tag=livewire:assets --force --ansi",
            "@php artisan filament:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.21"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
